<?xml version="1.0" encoding="utf-8"?>
<!-- The clock block's frame: pill_bg's frosted gradient and rim over a dark base, so the greeting, clock and
     date stay readable over a bright wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
